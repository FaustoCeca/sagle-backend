// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Saga {
  id          Int      @id @default(autoincrement())
  title        String   @unique
  isTheSagle Boolean  @default(false)
  lastTimeBeingSagle DateTime?
  wasSagleYesterday Boolean  @default(false)
  imageUrl   String
  categories  Category[]
  games      Game[]
  perspectives Perspective[]
  artStyles  ArtStyles []
  // yes, no, some
  hasMultiplayer String
  link       String
  createdAt   DateTime @default(now())

  @@index([title], name: "idx_saga_title")
  @@index([isTheSagle], name: "idx_saga_is_the_sagle")
  @@index([lastTimeBeingSagle], name: "idx_saga_last_time_being_sagle")
  @@index([wasSagleYesterday], name: "idx_saga_was_sagle_yesterday")
  @@index([hasMultiplayer], name: "idx_saga_has_multiplayer")
  @@index([link], name: "idx_saga_link")
  @@index([createdAt], name: "idx_saga_created_at")
}

model ArtStyles {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sagas     Saga[]
}

model Perspective {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sagas     Saga[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sagas     Saga[]
}

model Game {
  id         Int      @id @default(autoincrement())
  title       String   @unique
  birthYear   Int
  imageUrl   String
  sagaId   Int
  saga      Saga     @relation(fields: [sagaId], references: [id])
  steamLink String?
  votes Int
  createdAt  DateTime @default(now())

  @@index([title], name: "idx_game_title")
  @@index([birthYear], name: "idx_game_birth_year")
  @@index([imageUrl], name: "idx_game_image_url")
  @@index([sagaId], name: "idx_game_saga_id")
  @@index([steamLink], name: "idx_game_steam_link")
  @@index([votes], name: "idx_game_votes")
  @@index([createdAt], name: "idx_game_created_at")
}

model User {
  id         Int      @id @default(autoincrement())
  ipAddress   String   @unique
  lastParticipation DateTime? 
  hasParticipatedToday Boolean  @default(false)
  idsAttemptedToday Int[] @default([])
  hasVotedToday Boolean  @default(false)
  isAdmin   Boolean  @default(false)
  streak     Int      @default(0)

  @@index([ipAddress], name: "idx_user_ip_address")
  @@index([lastParticipation], name: "idx_user_last_participation")
  @@index([hasParticipatedToday], name: "idx_user_has_participated_today")
  @@index([hasVotedToday], name: "idx_user_has_voted_today")
  @@index([streak], name: "idx_user_streak")
  @@index([idsAttemptedToday], name: "idx_user_ids_attempted_today")
}